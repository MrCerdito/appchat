# CHAT INNOVACLOUD — Produccion (VPS Docker)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_NAME=app

# JWT (secrets generados)
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTE_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTE_HEX
JWT_EXPIRES=8h

# Servidor
PORT=3001
NODE_ENV=production
FRONTEND_PORT=8095

# CORS
CORS_ORIGINS=https://innoovacloud.com,https://cloud.sian365.co,https://web.sian365.co,https://app.sian365.co

# Resend
RESEND_API_KEY=CHANGE_ME_YOUR_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=CHANGE_ME_YOUR_RESEND_WEBHOOK_SECRET
MAIL_FROM=onboarding@resend.dev

# App
APP_URL=https://innoovacloud.com

# Google Gemini AI
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_API_KEY

# Cifrado AES-256-GCM
CHAT_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX

# WhatsApp
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_YOUR_WHATSAPP_VERIFY_TOKEN
VERIFY_TOKEN=CHANGE_ME_VERIFY_TOKEN

# Microsoft Teams — Reuniones por asesor + buzón compartido
# Las videollamadas las crea cada asesor con su cuenta (popup OAuth,
# flujo delegado). El evento se agenda en el buzón compartido usando
# el token de la app (client_credentials).
# Requiere en la App Registration (Azure):
#   - Application: OnlineMeetings.ReadWrite.All, Calendars.ReadWrite, User.Read.All
#   - Delegated: OnlineMeetings.ReadWrite, Calendars.ReadWrite
MICROSOFT_CLIENT_ID=CHANGE_ME
MICROSOFT_CLIENT_SECRET=CHANGE_ME
MICROSOFT_TENANT_ID=CHANGE_ME
# Buzón compartido donde se agendan los eventos (destino de la agenda).
TEAMS_MEETINGS_ACCOUNT=soporte@innovacloud.co
# Object ID (GUID) de esa cuenta en Entra ID. Si se omite, el backend lo
# resuelve con /users/{correo} (requiere permiso de aplicacion User.Read.All).
TEAMS_MEETINGS_ACCOUNT_ID=CHANGE_ME
# Redirect URI usada en el popup OAuth del asesor (debe coincidir en Azure).
MICROSOFT_REDIRECT_URI=https://innoovacloud.com/advisors-whatsapp/teams/oauth/callback
