# ═══════════════════════════════════════════════════════════════════════
# CHAT INNOVACLOUD — Variables de entorno (solo correo)
# Copia este archivo como backend/.env y ajusta los valores
# ═══════════════════════════════════════════════════════════════════════

# ── URL pública del backend ───────────────────────────────────────────
# Se usa para los enlaces que van dentro de los correos.
APP_URL=https://innoovacloud.com/korvix

# ── Mailsender API (correos de comunicados y tickets) ─────────────────
# Gateway de envio de correo. Valores por defecto del apartado "Mailsender
# API" de Configuracion (se usan de respaldo si no hay credencial guardada).
MAILSENDER_URL=https://mailsender.innovacloud.co
MAILSENDER_EMAIL=cuenta@tudominio.com
MAILSENDER_USUARIO=cuenta@tudominio.com
MAILSENDER_PASSWORD=contraseña
MAILSENDER_NOMBRE=vacio
MAILSENDER_PORT=587
MAILSENDER_SERVER=vacio
MAILSENDER_SSL=true
MAILSENDER_TLS12=true
MAILSENDER_AZURE_TENANT_ID=tu-tenant-id
MAILSENDER_AZURE_CLIENT_ID=tu-client-id
MAILSENDER_AZURE_CLIENT_SECRET=tu-client-secret

# ── Cifrado de mensajes de chat (obligatorio en producción) ────────────
# Si se deja vacío, los mensajes de los clientes se guardan EN TEXTO PLANO.
# Genera una con:  openssl rand -hex 32
# Si la cambias después, configura también CHAT_ENCRYPTION_KEY_FALLBACK con la
# clave anterior para poder seguir leyendo los mensajes ya cifrados.
CHAT_ENCRYPTION_KEY=

# ── Resend (email transaccional, respaldo de tickets) ────────────────
# Obtén tu API key en https://resend.com
RESEND_API_KEY=re_your-resend-api-key
# Remitente por defecto cuando no hay credencial SMTP guardada.
MAIL_FROM=onboarding@resend.dev
# Secreto para validar el webhook de Resend (opcional).
RESEND_WEBHOOK_SECRET=change-me-64-char-hex

# ── Microsoft Teams — Reuniones + calendario del grupo 'Soporte' ─────────
# Por defecto la videollamada se organiza en el Grupo de Microsoft 365
# 'Soporte'. Graph crea el evento con Teams incrustado en
# POST /groups/{groupId}/events con isOnlineMeeting:true. El asesor entra como
# invitado. Si no es posible resolver el grupo, cae automaticamente a
# 'shared-mailbox' (buzon soporte@innovacloud.co) para no romper el flujo.
# Con TEAMS_MEETING_ORGANIZER_SCOPE=advisor se vuelve al modo anterior
# (reunion creada por cada asesor).
# Requiere en la app registration (Entra ID):
#   - Application permissions: OnlineMeetings.ReadWrite.All, Calendars.ReadWrite,
#     User.Read.All, Group.Read.All, Group.ReadWrite.All
#   - Delegated permissions: OnlineMeetings.ReadWrite, Calendars.ReadWrite,
#     Group.ReadWrite.All (admin consent required for the group calendar flow)
#   - Todo con "Grant admin consent".
#   - Authentication → Platform "Web" → Redirect URI = MICROSOFT_REDIRECT_URI
MICROSOFT_CLIENT_ID=tu-application-client-id
MICROSOFT_CLIENT_SECRET=tu-client-secret-value
# Tenant (id o dominio innovacloud.co) para tokens de aplicacion y como respaldo
# del OAuth delegado. MICROSOFT_TENANT_ID, si se define, tiene prioridad en OAuth.
MICROSOFT_APP_TENANT_ID=
# Buzón compartido (respaldo/fallback cuando no se usa grupo).
TEAMS_MEETINGS_ACCOUNT=soporte@innovacloud.co
# Object ID (GUID) de ese buzón compartido en Entra ID.
TEAMS_MEETINGS_ACCOUNT_ID=
# group (default) | shared-mailbox | advisor
TEAMS_MEETING_ORGANIZER_SCOPE=group
# Nombre del grupo M365 donde se crea la reunión.
TEAMS_GROUP_NAME=Soporte
# (Opcional) ID del grupo M365. Si no se define, se resuelve por TEAMS_GROUP_NAME.
# Recomendado fijarlo: hoy hay dos grupos con displayName 'Soporte' y la
# resolucion por nombre podria elegir el que no tiene la agenda.
TEAMS_GROUP_ID=

# ── Calendario del grupo (lectura de la agenda real compartida) ──────────
# El modulo calendario/ NO usa el buzon compartido: lee el calendario del
# grupo M365 de arriba con /groups/{id}/calendarView y refleja TODOS los
# eventos que hay en el, sin filtrar por tipo ni por dia completo.
# Reusa MICROSOFT_CLIENT_ID/SECRET y el token cacheado de MicrosoftGraphMailService.
#   - Application permissions: Calendars.ReadWrite, Group.Read.All
#   - "Grant admin consent" en Entra ID.
CALENDARIO_GRUPO_ID=
# Nombre visible del grupo en la cabecera. Si CALENDARIO_GRUPO_ID y
# TEAMS_GROUP_ID estan vacios, se resuelve por este nombre.
CALENDARIO_GRUPO_NOMBRE=Soporte
# Cache en memoria por rango exacto (Graph pagina de 10 en 10: un mes cargado
# son ~22 viajes, y sin cache cada asesor los repite).
CALENDARIO_CACHE_SEGUNDOS=300
# Techo de paginas por lectura, para que un rango enorme no se cuelgue.
CALENDARIO_MAX_PAGINAS=60
# Ventana maxima que acepta Graph en calendarView (limite de Microsoft).
CALENDARIO_MAX_DIAS=1825
# Retrocompatibilidad (no usado si scope=group). shared | advisor
TEAMS_MEETING_ORGANIZER=shared
# Reply URL del popup OAuth de Teams.
MICROSOFT_REDIRECT_URI=http://localhost:3001/advisors-whatsapp/teams/oauth/callback

# ── Módulo de Correos (Microsoft Graph, buzón compartido) ────────────────
# Lee la carpeta del asesor dentro del buzón: <buzón>/ASIGNADOS/<nombre asesor>.
# Reusa las credenciales MICROSOFT_* de arriba: no hay secretos nuevos.
#
# PERMISOS REQUERIDOS en Entra ID sobre la app Korvix:
#   - Application permission: Mail.Read  (+ admin consent)
#   - Opcional, para mover/copiar correos: Mail.ReadWrite
#   - NO usar Mail.Read.Shared: ese permiso solo existe como Delegated y no
#     funciona con client_credentials (que es lo que corre este backend).
#
# SEGURIDAD: un permiso Application de correo alcanza TODOS los buzones del
# tenant por defecto. Para acotarlo a un solo buzón hay que crear en Exchange
# Online un Application Access Policy que apunte al App ID de Korvix.
CORREOS_MAILBOX_UPN=soporte@innovacloud.co
# Carpeta padre dentro del buzón que agrupa las carpetas por asesor.
CORREOS_CARPETA_PADRE=ASIGNADOS
# Cada cuántos minutos se buscan correos nuevos (delta de Graph). Mínimo 1.
# Este número ES la rapidez con la que se refleja en la app un cambio de
# "leído" hecho en Outlook: 2 min multiplica el tráfico a Graph por ~2.5
# respecto a 5, pero el delta en reposo devuelve casi vacío.
CORREOS_SYNC_MINUTOS=2
# false desactiva el job periódico (útil si sólo se quiere sincronizar a mano).
CORREOS_SYNC_ACTIVO=true

# ── Módulo SharePoint (solo lectura, biblioteca del sitio de Soporte) ──────
# Navega y descarga archivos de "Documentos compartidos" sin guardar nada en
# el servidor. Reusa las credenciales MICROSOFT_* de arriba: no hay secretos
# nuevos, pero SÍ hace falta un permiso que no existe todavía:
#
# PERMISO REQUERIDO en Entra ID sobre la app Korvix:
#   - Application permission: Sites.Read.All  (+ "Grant admin consent")
#   - Alternativa más acotada: Sites.Selected y darle acceso sólo a este sitio.
#   - Con delegated NO sirve: este módulo corre con client_credentials.
SHAREPOINT_HOSTNAME=innovacloud1.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Soporte
# Biblioteca por defecto ("Documentos compartidos"). Déjalo vacío o escribe el
# nombre exacto de otra biblioteca del sitio.
SHAREPOINT_LIBRARY=
